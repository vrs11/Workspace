{
  "productName": "Workspace Test",
  "identifier": "org.agentworkspace.desktop-test",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "desktop-test-driver",
          "windows": [
            "main",
            "workspace-*"
          ],
          "permissions": [
            "wdio:default",
            "core:window:allow-set-focus",
            "core:webview:allow-set-webview-focus",
            "core:window:allow-show",
            "core:webview:allow-webview-show",
            "core:window:allow-set-position",
            "core:window:allow-set-size",
            "core:window:allow-close"
          ]
        }
      ]
    }
  },
  "build": {
    "beforeBuildCommand": "pnpm build:desktop-web",
    "frontendDist": "../dist-desktop-test"
  }
}
