{
  "name": "agent-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.22.0"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "postinstall": "bash scripts/licenses.sh",
    "prepare:licenses": "bash scripts/licenses.sh",
    "prepare:vendor": "node scripts/prepare-vendor.mjs",
    "test:vendor": "node --test tests/vendor.test.mjs",
    "test:licenses": "node --test tests/licenses.test.mjs tests/license-notices.test.mjs",
    "build": "bash scripts/build.sh",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:rust": "bash scripts/cargo.sh test --lib --locked",
    "test:integration": "bash scripts/cargo.sh test --test integration --locked",
    "test:desktop": "node scripts/desktop-test.mjs",
    "test:perf": "node scripts/perf.mjs",
    "check:generated": "bash scripts/cargo.sh test --test generated --locked",
    "check:licenses": "bash scripts/licenses.sh --force",
    "desktop:build": "bash scripts/desktop-build.sh",
    "check:release-boundary": "node scripts/release-boundary.mjs",
    "test:terminal": "bash scripts/cargo.sh test --test terminal --locked",
    "build:desktop-web": "vite build --outDir dist-desktop-test",
    "test:desktop:stability": "node scripts/desktop-test.mjs --stability",
    "test:desktop:repair": "node scripts/desktop-test.mjs --repair",
    "check:windows-api": "bash scripts/windows-cross-check.sh",
    "test:crash": "bash scripts/cargo.sh test --test crash --features native-fixtures --locked",
    "test:perf:desktop": "node scripts/perf-desktop.mjs",
    "test:glib": "bash scripts/glib-test.sh",
    "check:vendor": "node scripts/check-vendor.mjs",
    "desktop:build:perf": "bash scripts/desktop-build.sh --release",
    "test:desktop:perf": "node scripts/desktop-test.mjs --performance",
    "test:updates": "bash scripts/cargo.sh test --test updates --locked",
    "test:release": "node --test tests/release.test.mjs",
    "test:disk-full": "bash scripts/disk-full-macos.sh",
    "test:desktop:launch": "node scripts/desktop-test.mjs --launch",
    "test:desktop:docking": "node scripts/desktop-test.mjs --docking",
    "test:desktop:interaction": "node scripts/desktop-test.mjs --interaction",
    "test:desktop:files": "node scripts/desktop-test.mjs --files",
    "test:desktop:projects": "node scripts/test-project-windows.mjs",
    "test:desktop:explorer": "node scripts/desktop-test.mjs --explorer",
    "test:desktop:editor": "node scripts/desktop-test.mjs --editor",
    "test:desktop:pointer": "node scripts/desktop-test.mjs --pointer",
    "test:desktop:features": "node scripts/desktop-test.mjs --features",
    "check:security": "node scripts/security-audit.mjs",
    "test:security": "bash scripts/licenses.sh && node --test tests/security-audit.test.mjs",
    "test:native-quit": "python3 scripts/test-native-quit-macos.py",
    "test:perf:session": "node scripts/perf-session-macos.mjs",
    "check:package-resources": "node scripts/package-resources.mjs",
    "prepare:desktop:interop": "node scripts/test-file-interop.mjs --prepare",
    "test:desktop:interop": "node scripts/test-file-interop.mjs --run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tanstack/react-virtual": "3.14.22",
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.61.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/logger": "9.29.1",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "expect-webdriverio": "6.1.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webdriverio": "9.32.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.17",
      "serialize-javascript": "7.1.4",
      "basic-ftp": "6.2.3",
      "@puppeteer/browsers": "3.2.6"
    }
  }
}
